[Unit]
Description=BikeShareYEG FastAPI backend (Gunicorn)
After=network.target

[Service]
Type=exec
User=bikeshare
Group=bikeshare
WorkingDirectory=/opt/bikeshareyeg
EnvironmentFile=/opt/bikeshareyeg/.env

ExecStart=/opt/bikeshareyeg/backend/.venv/bin/gunicorn \
    backend.src.api.main:app \
    --worker-class uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --graceful-timeout 30 \
    --access-logfile -

Restart=on-failure
RestartSec=5

# Resource limits — keep the VM healthy
MemoryMax=1G
CPUQuota=150%

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bikeshareyeg/data

[Install]
WantedBy=multi-user.target
