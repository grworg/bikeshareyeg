# BikeShareYEG Configuration
# Copy to .env and fill in values

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# Set to false in production — disables Swagger docs and verbose errors
BIKESHARE_DEBUG=true

# Bind address: 127.0.0.1 in production (Caddy proxies), 0.0.0.0 for dev
BIKESHARE_HOST=127.0.0.1
BIKESHARE_PORT=8000

# ---------------------------------------------------------------------------
# CORS — comma-separated allowed origins
# ---------------------------------------------------------------------------
# Development:
BIKESHARE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Production (grassrootswork.org):
# BIKESHARE_ALLOWED_ORIGINS=https://bikeshare.grassrootswork.org

# ---------------------------------------------------------------------------
# Sessions (per-visitor station state)
# ---------------------------------------------------------------------------
BIKESHARE_MAX_SESSIONS=200
BIKESHARE_SESSION_TTL_S=86400

# ---------------------------------------------------------------------------
# Rate limiting (format: "N/period" — e.g. "5/minute", "100/hour")
# ---------------------------------------------------------------------------
BIKESHARE_RATE_LIMIT_OPTIMIZE=3/minute
BIKESHARE_RATE_LIMIT_STEP=20/minute
BIKESHARE_RATE_LIMIT_ROUTES=15/minute
BIKESHARE_RATE_LIMIT_DEFAULT=60/minute

# ---------------------------------------------------------------------------
# Planner caps
# ---------------------------------------------------------------------------
BIKESHARE_MAX_NUM_STATIONS=100
BIKESHARE_MAX_EXISTING_STATIONS=200

# ---------------------------------------------------------------------------
# Database (network sharing persistence)
# ---------------------------------------------------------------------------
# docker-compose sets this automatically via the postgres service.
# For local dev without Docker, point at a local Postgres instance.
# BIKESHARE_DATABASE_URL=postgresql://bikeshare:bikeshare_dev@localhost:5432/bikeshareyeg

# Password for the bikeshareyeg Postgres container.
# Generate a real one for production: openssl rand -hex 32
BIKESHARE_POSTGRES_PASSWORD=bikeshare_dev

# ---------------------------------------------------------------------------
# Network sharing rate limits
# ---------------------------------------------------------------------------
BIKESHARE_RATE_LIMIT_SHARE_CREATE=5/hour
BIKESHARE_RATE_LIMIT_SHARE_READ=60/minute
BIKESHARE_MAX_NETWORK_PAYLOAD_KB=500

# ---------------------------------------------------------------------------
# OpenTripPlanner URL (docker-compose sets this automatically)
# ---------------------------------------------------------------------------
# OTP_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Optional: Edmonton Open Data app token (increases API rate limits)
# Register at https://data.edmonton.ca/profile/edit/developer_settings
# ---------------------------------------------------------------------------
BIKESHARE_OPEN_DATA_APP_TOKEN=
