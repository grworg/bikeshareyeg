# BikeShareYEG — Production Secrets (EXAMPLE)
#
# To use:
#   1. Copy to secrets.yml
#   2. Fill in values
#   3. Encrypt: ansible-vault encrypt secrets.yml
#   4. Never commit the unencrypted file!
#
# BikeShareYEG has minimal secrets — mostly just optional API tokens.

# =============================================================================
# OPTIONAL: Edmonton Open Data app token (increases rate limits)
# Register at https://data.edmonton.ca/profile/edit/developer_settings
# =============================================================================
edmonton_app_token: ""

# =============================================================================
# OPTIONAL: GitHub PAT (only if repo is private)
# =============================================================================
# github_token: "ghp_..."
