# BikeShareYEG — Production Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# DO NOT EDIT MANUALLY — changes will be overwritten on deploy.
# Edit infrastructure/ansible/group_vars/production.yml instead.

# =============================================================================
# DEPLOYMENT
# =============================================================================
BIKESHARE_DEBUG={{ debug | lower }}
BIKESHARE_HOST=0.0.0.0
BIKESHARE_PORT=8000

# =============================================================================
# CORS
# =============================================================================
BIKESHARE_ALLOWED_ORIGINS={{ allowed_origins }}

# =============================================================================
# SESSIONS
# =============================================================================
BIKESHARE_MAX_SESSIONS={{ max_sessions }}
BIKESHARE_SESSION_TTL_S={{ session_ttl_s }}

# =============================================================================
# RATE LIMITING
# =============================================================================
BIKESHARE_RATE_LIMIT_OPTIMIZE={{ rate_limit_optimize }}
BIKESHARE_RATE_LIMIT_STEP={{ rate_limit_step }}
BIKESHARE_RATE_LIMIT_ROUTES={{ rate_limit_routes }}
BIKESHARE_RATE_LIMIT_DEFAULT={{ rate_limit_default }}

# =============================================================================
# PLANNER CAPS
# =============================================================================
BIKESHARE_MAX_NUM_STATIONS={{ max_num_stations }}
BIKESHARE_MAX_EXISTING_STATIONS={{ max_existing_stations }}

# =============================================================================
# DATABASE (network sharing)
# =============================================================================
BIKESHARE_DATABASE_URL=postgresql://bikeshare:{{ postgres_password }}@postgres:5432/bikeshareyeg
BIKESHARE_POSTGRES_PASSWORD={{ postgres_password }}
BIKESHARE_RATE_LIMIT_SHARE_CREATE={{ rate_limit_share_create }}
BIKESHARE_RATE_LIMIT_SHARE_READ={{ rate_limit_share_read }}
BIKESHARE_MAX_NETWORK_PAYLOAD_KB={{ max_network_payload_kb }}

# =============================================================================
# OPTIONAL
# =============================================================================
{% if open_data_app_token is defined and open_data_app_token %}
BIKESHARE_OPEN_DATA_APP_TOKEN={{ open_data_app_token }}
{% endif %}
